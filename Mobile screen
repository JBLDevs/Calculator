        .calculator{
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            border: none;
            outline: none;
            border-radius: 10px;

            width: 95vw; /*17%*/
            max-width: 350px;

            height: 500px; /*57%*/
            margin: 15%;
            /*margin-top: 35%;*/

            padding: 10px;

            background: rgb(0, 32, 46);
            background: linear-gradient(0deg,rgba(0, 32, 46, 1) 0%, rgba(0, 46, 66, 1) 50%, rgb(0, 100, 143) 100%);
            box-shadow: 8px 10px 10px 0 rgba(86, 111, 122, 0.5);
            /*border: 1px solid red;*/
            transition-timing-function: ease;
            z-index: 2;
        }

        /*For number & operator display*/
        .display-container{ 
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            align-items: flex-end;
            margin-top: 1%;
            /*padding-right: 5px; /*adjust the place of the fnumber*/
            height: 115px; /*110*/
            border: 1px solid blue;
            border-radius: 8px;
            background-color: rgb(240, 248, 255);
            box-sizing: border-box;
        }
        .fnumber{
            width: 45vw;
            height: 25px;
            padding-right: 15px;
            text-align: right;
            color: rgb(0, 0, 0, 0.8);
            font-size: 22px;
            font-family: "Poppins", sans-serif;
            font-weight: 500;
            border: 1px solid red;
        }
        .display-container input[type="text"]{
            height: 75px; /*58px*/
            width: 95%;
            padding-right: 10px;
            margin-top: 0;
            text-align: right;
            border: none;
            outline: none;
            background: transparent;
            text-align: right;
            font-size: 48px;
            font-family: "Poppins", sans-serif;
            font-weight: 500;
            color: rgb(0, 0, 0, 0.8);
            caret-color: transparent; /*to remove the cursor*/
            border: 1px solid blue;
        }
        /*input#display{
            padding: 0 0;
        }*/


        /*Parent for all buttons*/
        .buttons-container{
            display: flex;
            flex-direction: row;
            justify-content: center;
            height: 90%;
        }

        /*Five buttons per row*/
        .container-1, .container-2, .container-3, .container-4{
            width: 25%; /*100%*/
            height: 47vh;
            padding-top: 2%;
            display: flex;
            flex-direction: column;
            align-items: center;
            /*border: 1px solid white;*/
        }
        .container-1 #clear, .container-2 #delete,
        .container-3 #division, .container-4 #multiplication,
        .container-4 #subtraction, .container-4 #addition, .container-4 #equal{
            color: rgb(240, 240, 240);
            background-color: rgb(27, 128, 172);
            
            
        }
        .container-1 #clear:hover, .container-2 #delete:hover,
        .container-3 #division:hover, .container-4 #multiplication:hover,
        .container-4 #subtraction:hover, .container-4 #addition:hover, .container-4 #equal:hover{
            font-family: "Poppins", sans-serif;
            font-weight: 400;
            font-size: 18px;
            box-shadow:
            0 9px 9px -5px rgb(189, 228, 245),
            0 -9px 9px -5px rgb(189, 228, 245),
            9px 0 9px -5px rgb(189, 228, 245),
            -9px 0 9px -5px rgb(189, 228, 245);
            /*0px 0px 5px 1px rgb(189, 228, 245);*/
            transition: 0.2s;
            transition-timing-function: ease-out;

            /*box-shadow: 
            0 10px 15px -3px #5391ee4f,
            0 4px 6px -2px #538feb17;*/
        }

        .container-4 #equal{
            /*border: 2px solid red;*/
            height: 140px;
            flex-grow: 1;
            /*margin: 10px 0 0 0;*/
        }.container-4 #equal:hover{
            
            /*0 10px 15px 3px #79a1dd4f,*/
            /*0 4px 6px -2px #488aec17;*/
        }

        .buttons-cl-19 {
            /*flex-grow: 1;*/
            display: flex;
            flex-direction: column;
            width: 100%;
            align-items: center;

        }

        .container-1 button[type="button"], .container-2 button[type="button"],
        .container-3 button[type="button"], .container-4 button[type="button"]{
            margin: 2px;
            /*padding: 20px;*/
            width: 79px;
            max-width: 80px;
            height: 68px;
            
            border: none;
            border-radius: 5px;

            font-family: "Poppins", sans-serif;
            font-weight: 400;
            font-size: 18px;
            color: rgb(0, 32, 46);
            /*border: 1px solid red;*/
            box-shadow: 5px 8px 8px 0 rgba(0, 32, 46, .5);
            cursor: pointer;
        }